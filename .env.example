# Copy to .env (git-ignored) and fill in. Credentials may instead be stored in the
# OS keyring under the service names "neo4j" (uri, user, pass) and "mongo" (uri).

# Directory holding the raw inputs (OpenAlex snapshot, Reliance on Science,
# Founding Patents, JCR and Scimago exports). Default: <repo>/data
SC_DATA_DIR=

# MongoDB holding the OpenAlex snapshot (database "openalex")
MONGO_URI=mongodb://localhost:27017/openalex

# Neo4j holding the citation graph (requires the Graph Data Science library)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=
